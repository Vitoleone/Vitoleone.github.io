---
import '@fontsource-variable/inter';
import '@fontsource-variable/oxanium';
import '../styles/global.css';

import type { CollectionEntry } from 'astro:content';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getUiCopy } from '../lib/ui/copy';
import { getLocalizedPath, type Language, type PageKey } from '../lib/ui/presentation';

interface Props {
  language: Language;
  page: PageKey;
  title: string;
  description: string;
  settings: CollectionEntry<'siteSettings'>['data'];
}

const { language, page, title, description, settings } = Astro.props;
const copy = getUiCopy(language);
const base = import.meta.env.BASE_URL;
const englishUrl = new URL(getLocalizedPath(page, 'en', base), settings.siteUrl);
const turkishUrl = new URL(getLocalizedPath(page, 'tr', base), settings.siteUrl);
const canonicalUrl = language === 'tr' ? turkishUrl : englishUrl;
---

<!doctype html>
<html lang={language} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let theme = 'light';
        try {
          theme = localStorage.getItem('portfolio-theme') === 'dark' ? 'dark' : 'light';
        } catch {
          theme = 'light';
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1018" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="tr" href={turkishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.siteTitle[language]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <Header language={language} page={page} />
    <main id="main-content">
      <slot />
    </main>
    <Footer language={language} settings={settings} />
  </body>
</html>
