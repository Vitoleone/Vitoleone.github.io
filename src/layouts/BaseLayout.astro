---
import '@fontsource-variable/inter';
import '@fontsource-variable/oxanium';
import '../styles/global.css';

import type { CollectionEntry } from 'astro:content';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { createPersonJsonLd } from '../lib/seo/structured-data';
import { getUiCopy } from '../lib/ui/copy';
import { getLocalizedPath, getProjectPath, type Language, type PageKey } from '../lib/ui/presentation';

type SitePage = PageKey | 'project' | 'not-found';

interface Props {
  language: Language;
  page: SitePage;
  projectSlug?: string;
  title: string;
  description: string;
  settings: CollectionEntry<'siteSettings'>['data'];
  profile?: CollectionEntry<'profile'>['data'];
  restoreLanguagePreference?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  structuredData?: unknown[];
}

const {
  language,
  page,
  projectSlug,
  title,
  description,
  settings,
  profile,
  restoreLanguagePreference = false,
  noindex = false,
  ogType = 'website',
  ogImage,
  structuredData = [],
} = Astro.props;
const copy = getUiCopy(language);
const base = import.meta.env.BASE_URL;
const englishPath = page === 'project' && projectSlug
  ? getProjectPath(projectSlug, 'en', base)
  : page === 'about'
    ? getLocalizedPath('about', 'en', base)
    : getLocalizedPath('home', 'en', base);
const turkishPath = page === 'project' && projectSlug
  ? getProjectPath(projectSlug, 'tr', base)
  : page === 'about'
    ? getLocalizedPath('about', 'tr', base)
    : getLocalizedPath('home', 'tr', base);
const englishUrl = new URL(englishPath, settings.siteUrl);
const turkishUrl = new URL(turkishPath, settings.siteUrl);
const canonicalUrl = language === 'tr' ? turkishUrl : englishUrl;
const jsonLd = [
  ...(profile ? [createPersonJsonLd(profile, settings, language)] : []),
  ...structuredData,
];
---

<!doctype html>
<html
  lang={language}
  data-theme="light"
  data-page={page}
  data-base-path={base}
  data-language-preference-entry={restoreLanguagePreference ? 'true' : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let theme = 'light';
        try {
          theme = localStorage.getItem('portfolio-theme') === 'dark' ? 'dark' : 'light';
        } catch {
          theme = 'light';
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <script>
      import { restoreLanguagePreference } from '../lib/ui/language-preference';

      const root = document.documentElement;
      restoreLanguagePreference({
        language: root.lang === 'tr' ? 'tr' : 'en',
        page: root.dataset.page === 'about' ? 'about' : 'home',
        isRootEntry: root.dataset.languagePreferenceEntry === 'true',
        base: root.dataset.basePath ?? '/',
      });
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1018" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {!noindex && <link rel="alternate" hreflang="tr" href={turkishUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={englishUrl} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={language === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:locale:alternate" content={language === 'tr' ? 'en_US' : 'tr_TR'} />
    <meta property="og:site_name" content={settings.siteTitle[language]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {jsonLd.map((entry) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(entry).replaceAll('<', '\\u003c')}
      ></script>
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <Header language={language} page={page} projectSlug={projectSlug} />
    <main id="main-content">
      <slot />
    </main>
    <Footer language={language} settings={settings} />
  </body>
</html>
