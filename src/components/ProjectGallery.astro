---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

import type { Language } from '../lib/ui/presentation';
import { localize } from '../lib/ui/presentation';
import type { ProjectBlock } from '../lib/content/layout-schemas';

interface Props {
  project: CollectionEntry<'projects'>;
  language: Language;
  layoutBlock?: ProjectBlock;
}

const { project, language, layoutBlock } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/project-media/*.{avif,gif,jpeg,jpg,png,svg,webp}',
  { eager: true },
);
const gallery = project.data.gallery.flatMap((item) => {
  const name = item.src.split('/').at(-1);
  const image = name ? images[`/src/assets/project-media/${name}`]?.default : undefined;
  return image ? [{ item, image }] : [];
});
const label = language === 'tr' ? 'Galeri' : 'Gallery';
---

{gallery.length > 0 && (
  <section
    class="project-gallery section"
    aria-labelledby="project-gallery-title"
    data-editor-block={layoutBlock?.id ?? 'gallery'}
    data-editor-variant={layoutBlock?.variant ?? 'standard'}
    data-editor-spacing={layoutBlock?.spacing ?? 'standard'}
    hidden={layoutBlock ? !layoutBlock.enabled : undefined}
    style={layoutBlock ? `order: ${layoutBlock.order}` : undefined}
  >
    <div class="shell">
      <p class="eyebrow"><span aria-hidden="true">//</span> {label}</p>
      <h2 id="project-gallery-title">{label}</h2>
      <ul role="list">
        {gallery.map(({ item, image }) => (
          <li>
            <figure>
              <img
                src={image.src}
                width={image.width}
                height={image.height}
                alt={localize(item.alt, language)}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{localize(item.alt, language)}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
