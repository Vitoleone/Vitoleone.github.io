---
import type { CollectionEntry } from 'astro:content';

import ProjectMedia from './ProjectMedia.astro';
import type { Language } from '../lib/ui/presentation';
import { localize } from '../lib/ui/presentation';

interface Props {
  project: CollectionEntry<'projects'>;
  language: Language;
}

const { project, language } = Astro.props;
const contributions = project.data.contributions;
const labels = language === 'tr'
  ? {
      section: 'Katkılar',
      carousel: `${project.data.title.tr} katkıları`,
      previous: 'Önceki katkı',
      next: 'Sonraki katkı',
      goTo: 'Katkıya git',
      slide: 'katkı',
    }
  : {
      section: 'Contributions',
      carousel: `${project.data.title.en} contributions`,
      previous: 'Previous contribution',
      next: 'Next contribution',
      goTo: 'Go to contribution',
      slide: 'contribution',
    };
---

{contributions.length > 0 && (
  <section class="project-contributions section" aria-labelledby="project-contributions-title">
    <div class="shell">
      <p class="eyebrow"><span aria-hidden="true">//</span> {labels.section}</p>
      <h2 id="project-contributions-title">{labels.section}</h2>

      <div class="project-carousel" role="region" aria-roledescription="carousel" aria-label={labels.carousel} data-project-carousel>
        <div
          class="project-carousel__viewport"
          tabindex="0"
          aria-label={labels.carousel}
          data-carousel-viewport
        >
          {contributions.map((contribution, index) => (
            <article
              class="project-carousel__slide"
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} / ${contributions.length}: ${localize(contribution.title, language)}`}
              data-carousel-slide
              data-slide-title={localize(contribution.title, language)}
            >
              <div class="project-carousel__copy">
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <h3>{localize(contribution.title, language)}</h3>
                <p>{localize(contribution.description, language)}</p>
              </div>
              {contribution.media && (
                <ProjectMedia media={contribution.media} language={language} active={index === 0} />
              )}
            </article>
          ))}
        </div>

        {contributions.length > 1 && (
          <div class="project-carousel__controls">
            <button type="button" aria-label={labels.previous} data-carousel-previous>←</button>
            <div class="project-carousel__dots" role="group" aria-label={labels.goTo}>
              {contributions.map((contribution, index) => (
                <button
                  type="button"
                  aria-label={`${labels.goTo}: ${localize(contribution.title, language)}`}
                  aria-current={index === 0 ? 'true' : undefined}
                  data-carousel-dot={index}
                >
                  <span class="sr-only">{index + 1}</span>
                </button>
              ))}
            </div>
            <button type="button" aria-label={labels.next} data-carousel-next>→</button>
          </div>
        )}

        <p class="sr-only" aria-live="polite" data-carousel-status>
          1 / {contributions.length}: {localize(contributions[0].title, language)}
        </p>
      </div>
    </div>
  </section>
)}

<script>
  import {
    getDirectionalSlideIndex,
    getNearestSlideIndex,
  } from '../lib/ui/project-carousel';

  document.querySelectorAll<HTMLElement>('[data-project-carousel]').forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>('[data-carousel-viewport]');
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]')];
    const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-previous]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const status = carousel.querySelector<HTMLElement>('[data-carousel-status]');
    let activeIndex = 0;
    let scrollFrame = 0;

    if (!viewport || slides.length === 0) return;

    const activateMedia = (index: number) => {
      slides.forEach((slide, slideIndex) => {
        slide.querySelectorAll<HTMLVideoElement>('video').forEach((video) => {
          if (slideIndex !== index) video.pause();
        });

        if (slideIndex === index) {
          slide.querySelectorAll<HTMLIFrameElement>('iframe[data-src]').forEach((frame) => {
            if (!frame.hasAttribute('src') && frame.dataset.src) frame.src = frame.dataset.src;
          });
        }
      });
    };

    const setActive = (index: number) => {
      activeIndex = Math.min(Math.max(index, 0), slides.length - 1);
      dots.forEach((dot, dotIndex) => {
        if (dotIndex === activeIndex) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (previous) previous.disabled = activeIndex === 0;
      if (next) next.disabled = activeIndex === slides.length - 1;
      if (status) {
        status.textContent = `${activeIndex + 1} / ${slides.length}: ${slides[activeIndex].dataset.slideTitle ?? ''}`;
      }
      activateMedia(activeIndex);
    };

    const goTo = (index: number) => {
      const target = slides[index];
      if (!target) return;
      viewport.scrollTo({
        left: target.offsetLeft - slides[0].offsetLeft,
        behavior: 'smooth',
      });
      setActive(index);
    };

    previous?.addEventListener('click', () => {
      goTo(getDirectionalSlideIndex(activeIndex, 'previous', slides.length));
    });
    next?.addEventListener('click', () => {
      goTo(getDirectionalSlideIndex(activeIndex, 'next', slides.length));
    });
    dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));

    viewport.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      if (event.key === 'Home') goTo(0);
      else if (event.key === 'End') goTo(slides.length - 1);
      else goTo(getDirectionalSlideIndex(activeIndex, event.key === 'ArrowLeft' ? 'previous' : 'next', slides.length));
    });

    viewport.addEventListener('scroll', () => {
      window.cancelAnimationFrame(scrollFrame);
      scrollFrame = window.requestAnimationFrame(() => {
        const firstOffset = slides[0].offsetLeft;
        setActive(getNearestSlideIndex(
          viewport.scrollLeft,
          slides.map((slide) => slide.offsetLeft - firstOffset),
        ));
      });
    }, { passive: true });

    setActive(0);
  });
</script>
