---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';

import Icon from './Icon.astro';
import { getVisibleCtas } from '../lib/content/helpers';
import { getUiCopy } from '../lib/ui/copy';
import { getProjectPath, localize, type Language } from '../lib/ui/presentation';

interface Props {
  project: CollectionEntry<'projects'>;
  language: Language;
  featured?: boolean;
}

const { project, language, featured = false } = Astro.props;
const copy = getUiCopy(language);
const { data } = project;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/project-media/*.{avif,gif,jpeg,jpg,png,svg,webp}',
  { eager: true },
);
const coverName = data.cover?.src.split('/').at(-1);
const cover = coverName ? images[`/src/assets/project-media/${coverName}`]?.default : undefined;
const ctas = getVisibleCtas(data.links);
const projectHref = getProjectPath(data.slug, language, import.meta.env.BASE_URL);
const ctaLabels = {
  play: copy.ctaPlay,
  store: copy.ctaStore,
  source: copy.ctaSource,
  info: copy.ctaInfo,
};
---

<article class:list={['project-card', featured && 'project-card--featured']}>
  <div class="project-card__media">
    {cover && data.cover ? (
      <img
        src={cover.src}
        width={cover.width}
        height={cover.height}
        alt={localize(data.cover.alt, language)}
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="project-card__placeholder" aria-hidden="true"><span>NO SIGNAL</span></div>
    )}
    <span class="project-card__index" aria-hidden="true">{String(data.order).padStart(2, '0')}</span>
  </div>

  <div class="project-card__body">
    <div class="project-card__topline">
      <p>{localize(data.role, language)}</p>
      {data.releaseYear && <p>{data.releaseYear}</p>}
    </div>
    <h3><a href={projectHref}>{localize(data.title, language)}</a></h3>
    <p class="project-card__summary">{localize(data.summary, language)}</p>

    {(data.developer || data.publisher) && (
      <dl class="project-card__meta">
        {data.developer && <><dt>{copy.developer}</dt><dd>{data.developer}</dd></>}
        {data.publisher && <><dt>{copy.publisher}</dt><dd>{data.publisher}</dd></>}
      </dl>
    )}

    {data.technologies.length > 0 && (
      <ul class="tag-list" aria-label={copy.technologies}>
        {data.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
    )}

    {ctas.length > 0 && (
      <div class="project-card__actions">
        {ctas.map((cta) => (
          <a class="text-link" href={cta.href} target="_blank" rel="noreferrer">
            {ctaLabels[cta.kind]}
            <span class="sr-only"> ({copy.externalLink})</span>
            <Icon name="external" size={17} />
          </a>
        ))}
      </div>
    )}
  </div>
</article>
