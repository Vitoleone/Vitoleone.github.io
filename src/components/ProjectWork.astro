---
import type { CollectionEntry } from 'astro:content';

import ProjectMedia from './ProjectMedia.astro';
import type { Language } from '../lib/ui/presentation';
import { localize } from '../lib/ui/presentation';

interface Props {
  project: CollectionEntry<'projects'>;
  language: Language;
}

const { project, language } = Astro.props;
const work = project.data.projectWork
  ?? project.data.contributions.find((contribution) => contribution.media)
  ?? project.data.contributions[0];
const fallbackTitle = language === 'tr' ? 'Projede yaptıklarım' : 'Project work';
---

{work && (
  <section class="project-work section" aria-labelledby="project-work-title">
    <div class="shell">
      <p class="eyebrow"><span aria-hidden="true">//</span> {fallbackTitle}</p>
      <div class="project-work__content">
        <div>
          <h2 id="project-work-title">{localize(work.title, language)}</h2>
          <p>{localize(work.description, language)}</p>
        </div>
        {work.media && <ProjectMedia media={work.media} language={language} />}
      </div>
    </div>
  </section>
)}
