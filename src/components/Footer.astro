---
import type { CollectionEntry } from 'astro:content';

import Icon from './Icon.astro';
import { getUiCopy } from '../lib/ui/copy';
import { getLocalizedPath, type Language } from '../lib/ui/presentation';

interface Props {
  language: Language;
  settings: CollectionEntry<'siteSettings'>['data'];
}

const { language, settings } = Astro.props;
const copy = getUiCopy(language);
const homeHref = getLocalizedPath('home', language, import.meta.env.BASE_URL);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner shell">
    <div>
      <a class="site-footer__brand" href={homeHref}>NOYAN BERKAY AŞKIN</a>
      <p>{copy.footerNote}</p>
    </div>
    <div class="site-footer__links" aria-label={copy.socialProfiles}>
      {settings.socials.map((social) => (
        <a href={social.url} target="_blank" rel="noreferrer">
          {social.label}<Icon name="external" size={15} />
        </a>
      ))}
    </div>
    <p class="site-footer__meta">© {year} · {language.toUpperCase()} // PORTFOLIO</p>
  </div>
</footer>
